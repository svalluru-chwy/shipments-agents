# Shipments Agency Platform - Environment Variables
# Copy to .env and fill in your values

# === Required ===

# OpenAI API Key (for LLM-based skills and agents)
OPENAI_API_KEY=

# AWS (for S3 access - uses SSO by default, or set explicit keys)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_PROFILE=PowerUserAccess-977247693856

# === Optional: Snowflake (for data-extraction package) ===
# If not set, falls back to config.yaml values
# SNOWFLAKE_ACCOUNT=chewy.us-east-1
# SNOWFLAKE_USER=user@chewy.com
# SNOWFLAKE_WAREHOUSE=SC_FORECAST_WH
# SNOWFLAKE_DATABASE=EDLDB
# SNOWFLAKE_SCHEMA=sc_user_tools_analytics_sandbox
# SNOWFLAKE_ROLE=SC_USER_TOOLS_ANALYTICS_DEVELOPER

# === Optional: Gateway ===
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000
